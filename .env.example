# ============================================
# 环境变量配置模板
# 您可以复制此文件为.env并填入实际的API密钥
# ============================================

# ============================================
# 阿里云模型配置
# ============================================
# 用于：Qwen系列模型（qwen-max、qwq-plus等）和语音服务（TTS）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 其他模型配置
# ============================================
# 用于：GPT、Gemini、Grok等OpenAI兼容的模型
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=your_openai_base_url_here

# ============================================
# 搜索服务配置
# ============================================
# 用于：Google Serper 网络搜索；以及学术诚信模块对【中文参考文献】在
#       国家哲社文献中心/知网/万方/维普站内逐条联网核验真实性。
# 前往 https://serper.dev 注册（注册即送免费额度）获取；留空则中文文献
# 仅做本地题录库比对 + 格式核验，英文/带 DOI 文献不受影响。
SERPER_API_KEY=your_serper_api_key_here
# 中文库站内检索开关（配置 SERPER_API_KEY 后生效）
CNKI_SNIPPET_SEARCH_ENABLED=true
VIP_SNIPPET_SEARCH_ENABLED=true

# ============================================
# 模型名称配置
# ============================================
# 用于：指定各个服务使用的具体模型名称

# 标签提取服务使用的模型
TAGGING_MODEL_NAME=gpt-5-mini

# 城市治理评估服务中的答案生成模型
URBAN_GOV_ANSWER_MODEL=gpt-5-mini

# 城市治理评估服务中的评判模型
URBAN_GOV_JUDGE_MODEL=gpt-5-mini

